{
  "name": "Java 17 + Gradle 8.10",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem",
      "installGradle": true,
      "gradleVersion": "8.10",
      "installMaven": false
    }
  },

  "containerEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
  },

  "remoteEnv": {
    "PATH": "${containerEnv:JAVA_HOME}/bin:${containerEnv:PATH}"
  },

  "forwardPorts": [8080],

  "postCreateCommand": "java -version && gradle --version",

  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vscjava.vscode-gradle"]
    },
    "jetbrains": {
      "backend": "IntelliJ"
    }
  }
}